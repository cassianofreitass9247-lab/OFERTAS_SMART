# Copie este arquivo para ".env.local" e preencha. Nunca envie o .env.local para o GitHub.

# Supabase > Project Settings > API (ou "Data API") > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Project Settings > API Keys > chave "anon" / "publishable".
# ATENÇÃO: use somente a chave pública. A chave "service_role"/"secret" NÃO é usada por este projeto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Endereço público do site, sem barra no final (ex.: https://ofertasmart.com.br)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail exibido na página de contato e na política de privacidade
NEXT_PUBLIC_CONTATO_EMAIL=

# Nome do responsável pelo site (pessoa ou empresa), exibido na política de privacidade
NEXT_PUBLIC_RESPONSAVEL=
