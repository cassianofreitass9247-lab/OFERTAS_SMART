{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ofertasmart",
  "main": "worker.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "triggers": { "crons": ["0 12 * * *"] },
  "observability": { "enabled": true }
}
