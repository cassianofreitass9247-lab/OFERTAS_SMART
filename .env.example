# Copie este arquivo para ".env.local" e preencha. Nunca envie o .env.local para o GitHub.

# Supabase > Project Settings > API (ou "Data API") > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Project Settings > API Keys > chave "anon" / "publishable".
# ATENÇÃO: use somente a chave pública. A chave "service_role"/"secret" NÃO é usada por este projeto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Endereço público do site, sem barra no final (ex.: https://vitrinedamoni.com.br)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail exibido na página de contato e na política de privacidade
NEXT_PUBLIC_CONTATO_EMAIL=

# Nome do responsável pelo site (pessoa ou empresa), exibido na política de privacidade
NEXT_PUBLIC_RESPONSAVEL=

# Link do grupo do Telegram (https://t.me/...). Enquanto vazio, os botões de grupo levam ao Instagram.
NEXT_PUBLIC_TELEGRAM_URL=

# Proteção contra robôs (Cloudflare Turnstile). Em produção, cadastre no Worker (Settings > Variables and Secrets),
# não como variável de build. A chave secreta deve ser do tipo "Secret". Veja o README.
# Chaves de teste oficiais (sempre aprovam): 1x00000000000000000000AA e 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shopee Affiliate Open API (portal de afiliados). Em produção, cadastre no Worker (Settings > Variables and Secrets);
# o Secret deve ser do tipo "Secret". Nunca coloque em NEXT_PUBLIC_*. Veja o README.
SHOPEE_APP_ID=
SHOPEE_SECRET=

# ---------------------------------------------------------------------------
# MARCA (opcional). Sem nenhuma destas variáveis o site usa a marca padrão (Vitrine da Moni).
# Como são NEXT_PUBLIC_*, entram no site na hora do build: cadastre-as como variáveis de BUILD
# (Cloudflare > Workers Builds > Variables) e faça um novo deploy depois de mudar qualquer uma.
# Valores inválidos são ignorados (usa-se o padrão) e aparecem como "Marca: ..." nas pendências do painel.
# ---------------------------------------------------------------------------
# Nome do site e o artigo dele: "a" (a Vitrine da Moni) ou "o" (o Achados do João)
NEXT_PUBLIC_MARCA_NOME_SITE=
NEXT_PUBLIC_MARCA_ARTIGO_SITE=
# Nome completo, apelido (como o site se refere à pessoa) e artigo do apelido: "a" ou "o"
NEXT_PUBLIC_MARCA_NOME_PESSOA=
NEXT_PUBLIC_MARCA_APELIDO=
NEXT_PUBLIC_MARCA_ARTIGO=
# @ do Instagram (sem o @ ou com) e WhatsApp com DDD (ex.: 11912345678)
NEXT_PUBLIC_MARCA_INSTAGRAM=
NEXT_PUBLIC_MARCA_WHATSAPP=
# Foto: caminho de um arquivo em /public (ex.: /foto.jpg) ou endereço https
NEXT_PUBLIC_MARCA_FOTO=
# Apresentação (2 parágrafos; se informar só o primeiro, o segundo fica em branco) e descrição para o Google (10 a 200 caracteres)
NEXT_PUBLIC_MARCA_BIO=
NEXT_PUBLIC_MARCA_BIO2=
NEXT_PUBLIC_MARCA_DESCRICAO=
# Cores (#rrggbb): principal (cabeçalho, botões) e destaque (estrelas, selos). Principal não pode ser escura.
NEXT_PUBLIC_MARCA_COR=
NEXT_PUBLIC_MARCA_COR_DESTAQUE=
